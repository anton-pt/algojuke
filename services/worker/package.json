{
  "name": "@algojuke/worker",
  "version": "0.1.0",
  "description": "Background task queue worker service using Inngest",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.2",
    "@google/genai": "^1.34.0",
    "@qdrant/js-client-rest": "^1.16.2",
    "ai": "^6.0.5",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "inngest": "^3.22.12",
    "langfuse": "^3.38.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
