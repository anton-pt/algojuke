{
  "name": "@algojuke/observability",
  "version": "0.1.0",
  "description": "Langfuse-based observability service for LLM, vector search, and HTTP tracing",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "demo:generation": "npx tsx scripts/demo-generation-trace.ts",
    "demo:search": "npx tsx scripts/demo-search-trace.ts",
    "demo:http": "npx tsx scripts/demo-http-trace.ts",
    "demo:correlated": "npx tsx scripts/demo-correlated-trace.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "langfuse": "^3.38.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
